{
  "name": "Mnemo",
  "short_name": "Mnemo",
  "description": "Relational memory for dealmakers",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fbfbfd",
  "theme_color": "#fbfbfd",
  "icons": [{ "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "share_title", "text": "share_text", "url": "share_url" }
  },
  "shortcuts": [
    { "name": "Record a voice note", "short_name": "Record", "url": "./?do=record", "icons": [{ "src": "icon.svg", "sizes": "any" }] },
    { "name": "Tell Mnemo", "short_name": "Tell", "url": "./?do=tell", "icons": [{ "src": "icon.svg", "sizes": "any" }] },
    { "name": "New person", "short_name": "New", "url": "./?do=new", "icons": [{ "src": "icon.svg", "sizes": "any" }] }
  ]
}
